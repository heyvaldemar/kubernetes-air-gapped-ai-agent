.cache/
__pycache__/
out/

# Terraform for the AWS run (aws/): providers and plans stay local
aws/.terraform/
aws/*.tfplan
aws/*.tfstate*

# Terraform for the GKE run (gke/) and its bootstrap: providers, plans and
# local state stay local; the bootstrap's state lives in the state bucket
gke/.terraform/
gke/bootstrap/.terraform/
gke/**/*.tfplan
gke/**/*.tfstate*
gke/**/backend_override.tf
