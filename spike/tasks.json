 {
  "id": "lookup-email",
  "category": "task",
  "tools": [
   "records_lookup"
  ],
  "user": "What is the email address of customer C-1001?",
  "fixtures": {
   "records_lookup": {
    "{\"customer_id\": \"C-1001\"}": {
     "customer_id": "C-1001",
     "name": "Ana Silva",
     "email": "ana@acme.example",
     "plan": "Team",
     "open_tickets": 2
    }
   }
  },
  "expect": {
   "calls": [
    {
     "name": "records_lookup",
     "args": {
      "customer_id": "C-1001"
     }
    }
   ],
